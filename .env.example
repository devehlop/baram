# Токен бота от @BotFather. Для разработки — отдельный тестовый бот.
BOT_TOKEN=123456:replace-me

# Подключение к PostgreSQL. Для разработки подходит база из docker-compose.yml.
DATABASE_URL=postgres://baram:baram@localhost:5432/baram

# Telegram ID админов через запятую. Свой ID подскажет бот: команда /id.
ADMIN_IDS=

# Часовой пояс расписания рейсов.
APP_TZ=Europe/Moscow

# Уровень логов: debug, info, warn, error.
LOG_LEVEL=info

# Канал направления Буинск ⇄ Казань (например @baram_buinsk). Используется при первом заполнении базы;
# позже канал меняется в боте: Админ → Настройки → Канал.
CHANNEL_ID=

# Mini App. Пусто — выключен, бот работает только в чате.
# Чтобы включить: публичный адрес с HTTPS, например https://app.example.ru
MINIAPP_URL=
# Домен для автоматического сертификата (docker-compose.prod.yml, профиль miniapp), без https://
MINIAPP_DOMAIN=
# Порт, на котором бот отдаёт Mini App внутри сервера.
PORT=8080
